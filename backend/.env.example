# Server Config
HOST=0.0.0.0
PORT=8000
SECRET_KEY=audiobot_super_secret_key_change_me_in_prod
DEMO_MODE=false

# Providers Configuration
STT_PROVIDER=faster_whisper   # Options: faster_whisper, mock, deepgram, groq
STT_MODEL=tiny.en            # Options: tiny.en, base.en, small.en, medium.en

TTS_PROVIDER=edge_tts         # Options: edge_tts, cartesia, elevenlabs
TTS_VOICE=en-US-AvaNeural     # Voice for edge-tts

LLM_PROVIDER=ollama           # Options: ollama, mock, openai, groq, anthropic, gemini
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2        # Options: llama3.2, llama3, phi3, qwen2.5, tinyllama, mistral

# API Keys (Optional if using local faster_whisper, Ollama, and edge_tts)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Audio Configuration
SAMPLE_RATE=16000
CHANNELS=1
CHUNK_SIZE=512
VAD_THRESHOLD=0.5
SILENCE_DURATION_MS=700
